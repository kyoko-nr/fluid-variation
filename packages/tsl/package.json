    "_lint": "biome lint .",
    "_format": "biome format --write ."
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/three": "^0.180.0",
    "typescript": "~5.9.3"
  }
}
