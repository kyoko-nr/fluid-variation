{
  "$schema": "https://biomejs.dev/schemas/2.3.0/schema.json",
  "files": {
    "includes": ["**/*", "!**/nodemodules/*", "!**/dist/*"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noUselessTypeConstraint": "error",
        "noVoid": "error"
      },
      "correctness": {
        "noUnknownProperty": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  }
}
